{
    "version": 3,
    "port": 8080,
    "name": "API Gateway",
    "extra_config": {
        "github_com/devopsfaith/krakend-cors": {
            "allow_origins": ["http://localhost:3000"],
            "allow_methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
            "allow_headers": ["Content-Type", "Authorization", "X-User-Id", "X-Username", "X-User-Roles"],
            "expose_headers": ["X-User-Id", "X-Username", "X-User-Roles", "Set-Cookie"],
            "allow_credentials": true,
            "max_age": "12h"
        },
        "telemetry/logging": {
            "level": "DEBUG",
            "prefix": "[KRAKEND]",
            "skip_paths": ["/health"]
        }
    },
    "timeout": "10s",
    "cache_ttl": "5m",
    "host": ["http://0.0.0.0:8080"],
    "endpoints": [
        {
            "endpoint": "/health",
            "method": "GET",
            "output_encoding": "no-op",
            "backend": [
                {
                    "host": ["http://auth-service:8000"],
                    "url_pattern": "/health"
                }
            ]
        },

        {
            "endpoint": "/api/v1/auth/register",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "host": ["http://auth-service:8000"],
                    "url_pattern": "/api/v1/auth/register",
                    "encoding": "no-op"
                }
            ]
        },
        {
            "endpoint": "/api/v1/auth/login",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "host": ["http://auth-service:8000"],
                    "url_pattern": "/api/v1/auth/login",
                    "encoding": "no-op"
                }
            ]
        },
        {
            "endpoint": "/api/v1/auth/forgot-password",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "host": ["http://auth-service:8000"],
                    "url_pattern": "/api/v1/auth/forgot-password",
                    "encoding": "no-op"
                }
            ]
        },
        {
            "endpoint": "/api/v1/auth/reset-password",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "host": ["http://auth-service:8000"],
                    "url_pattern": "/api/v1/auth/reset-password",
                    "encoding": "no-op"
                }
            ]
        },
        {
            "endpoint": "/api/v1/auth/refresh",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "host": ["http://auth-service:8000"],
                    "url_pattern": "/api/v1/auth/refresh",
                    "encoding": "no-op"
                }
            ]
        },
        {
            "endpoint": "/api/v1/auth/logout",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "host": ["http://auth-service:8000"],
                    "url_pattern": "/api/v1/auth/logout",
                    "encoding": "no-op"
                }
            ]
        },
        {
            "endpoint": "/api/v1/auth/logout-all",
            "method": "POST",
            "output_encoding": "no-op",
            "input_headers": ["Authorization"],
            "backend": [
                {
                    "host": ["http://auth-service:8000"],
                    "url_pattern": "/api/v1/auth/logout-all",
                    "encoding": "no-op"
                }
            ]
        },
        {
            "endpoint": "/api/v1/auth/verify-email",
            "method": "POST",
            "output_encoding": "no-op",
            "backend": [
                {
                    "host": ["http://auth-service:8000"],
                    "url_pattern": "/api/v1/auth/verify-email",
                    "encoding": "no-op"
                }
            ]
        },

        {
            "endpoint": "/profile/{user_id}",
            "method": "GET",
            "output_encoding": "no-op",
            "input_headers": ["Authorization", "X-User-Id", "X-Username", "X-User-Roles"],
            "backend": [
